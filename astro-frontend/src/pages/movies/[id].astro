---
import { getMovieDetails } from "../../services/movieService";
import { getKinocheckTrailers } from "../../services/kinocheckService";
import { isMovieBlocked, isMovieNoIndex } from "../../lib/blockedIds";
import { SITE_URL, TMDB_IMG, truncate, jsonLd } from "../../lib/seo";

import MovieCard from "../../components/cards/MovieCard";
import CastRow from "../../components/sliders/CastRow";
import ClientStreamPlayer from "../../components/player/ClientStreamPlayer";
import WatchmodeAvailabilityBanner from "../../components/ui/WatchmodeAvailabilityBanner";
import KinocheckTrailerSection from "../../components/player/KinocheckTrailerSection";
import AdsterraNativeBanner from "../../components/ads/AdsterraNativeBanner";
import ShareButton from "../../components/ui/ShareButton";
import ServerNoteBanner from "../../components/ui/ServerNoteBanner";
import { Calendar, Clock, Download, Globe, Star, Play } from "lucide-react";
import Layout from "../../layouts/Layout.astro";

// Enable SSR for this page
export const prerender = false;

const { id } = Astro.params;

if (!id || isMovieBlocked(id)) {
    return Astro.redirect('/404');
}

const movieData = await getMovieDetails(id, "movie");

if (!movieData) {
    return Astro.redirect('/404');
}

const movie = movieData as any;
const trailers = await getKinocheckTrailers(movie.tmdbId, false, movie.videos);
const primaryTrailer = trailers[0];

const safeDate = movie.releaseDate && !isNaN(new Date(movie.releaseDate).getTime())
    ? new Date(movie.releaseDate)
    : null;
const releaseYear = safeDate ? safeDate.getFullYear() : "";

const isUpcoming = safeDate ? safeDate.getTime() > Date.now() : false;
const genreLabel = (movie.genres || []).slice(0, 2).join(' & ') || 'Movie';
const titleText = isUpcoming
    ? `Cast of ${movie.title}, Release Date & Everything We Know`
    : `${movie.title} ${releaseYear ? `(${releaseYear}) ` : ""}— Cast, Trailers & Where to Watch`;

const facts = [
    releaseYear && `${releaseYear}`,
    genreLabel.toLowerCase() !== "movie" && genreLabel,
    movie.rating > 0 && `★ ${movie.rating.toFixed(1)}/10`,
].filter(Boolean).join(" · ");
const starring = (movie.cast || []).slice(0, 2).map((c: any) => c.name).join(" & ");
const descriptionText = isUpcoming
    ? truncate(`${movie.title}${releaseYear ? ` (${releaseYear})` : ""}: release date, cast${starring ? ` (${starring})` : ""}, trailer & everything we know. ${movie.overview}`)
    : truncate(`${facts ? `${facts}. ` : ""}${starring ? `Starring ${starring}. ` : ""}Where to watch ${movie.title}, trailer & full cast. ${movie.overview}`);

const baseUrl = SITE_URL;
const pageUrl = `${baseUrl}/movies/${id}`;

const pageJsonLd = {
    "@context": "https://schema.org",
    "@graph": [
        {
            "@type": "WebPage",
            "@id": `${pageUrl}#webpage`,
            "url": pageUrl,
            "name": `${movie.title}${releaseYear ? ` (${releaseYear})` : ""} — Cast, Trailers & Where to Watch`,
            "inLanguage": "en",
        },
        {
            "@type": "Movie",
            "@id": `${pageUrl}#movie`,
            "name": movie.title,
            "url": pageUrl,
            "description": movie.overview,
            "datePublished": movie.releaseDate,
        }
    ]
};
---

<Layout title={titleText} description={descriptionText}>
    <script
        id="json-ld-movie"
        type="application/ld+json"
        set:html={jsonLd(pageJsonLd)}
    />

    <main class="min-h-screen bg-black text-white overflow-x-hidden">
        {/* IMMERSIVE 2-COLUMN HERO */}
        <section class="relative min-h-[75vh] sm:min-h-[85vh] w-full flex items-center py-20 md:py-28 lg:py-32 overflow-hidden bg-black">
            {/* Backdrop Image */}
            <div class="absolute inset-0 z-0">
                {movie.backdropPath ? (
                    <img
                        src={`${TMDB_IMG}/w1280${movie.backdropPath}`}
                        alt={movie.title}
                        class="w-full h-full object-cover opacity-65"
                    />
                ) : (
                    <div class="h-full w-full bg-neutral-900" />
                )}
            </div>

            <div class="absolute inset-0 bg-gradient-to-t from-black via-black/50 to-black/10 z-1" />
            <div class="absolute inset-0 bg-gradient-to-r from-black/80 via-black/35 to-transparent z-1" />

            {/* Hero Content Container */}
            <div class="relative z-10 w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                <div class="grid grid-cols-1 md:grid-cols-12 gap-8 items-center">
                    
                    {/* Poster Column */}
                    <div class="md:col-span-4 lg:col-span-3 flex justify-center md:justify-start">
                        <div class="relative w-44 sm:w-56 md:w-full aspect-[2/3] rounded-3xl overflow-hidden border border-white/10 shadow-[0_0_50px_rgba(220,38,38,0.3)] bg-neutral-900 group">
                            {movie.posterPath ? (
                                <img
                                    src={`${TMDB_IMG}/w500${movie.posterPath}`}
                                    alt={movie.title}
                                    class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
                                />
                            ) : (
                                <div class="h-full w-full bg-neutral-800 flex items-center justify-center text-neutral-500 text-xs font-bold">
                                    No Poster
                                </div>
                            )}

                            {movie.rating > 0 && (
                                <div class="absolute top-3 right-3 flex items-center gap-1 rounded-full bg-black/80 px-2.5 py-1 text-xs font-black text-yellow-400 border border-white/10 backdrop-blur-md shadow-lg">
                                    <Star size={12} fill="currentColor" />
                                    {movie.rating.toFixed(1)}
                                </div>
                            )}
                        </div>
                    </div>

                    {/* Details Column */}
                    <div class="md:col-span-8 lg:col-span-9 space-y-5 text-center md:text-left min-w-0">
                        <div class="flex flex-wrap items-center justify-center md:justify-start gap-2.5">
                            <span class="rounded-full bg-red-600/20 border border-red-500/30 px-3 py-1 text-[10px] sm:text-xs font-black uppercase tracking-widest text-red-500 backdrop-blur-md shadow-sm">
                                MOVIE
                            </span>
                            {movie.genres?.[0] && (
                                <span class="rounded-full bg-white/5 border border-white/10 px-3 py-1 text-[10px] sm:text-xs font-black uppercase tracking-widest text-neutral-300 backdrop-blur-md">
                                    {movie.genres[0]}
                                </span>
                            )}
                        </div>

                        <h1 class="text-2xl sm:text-4xl md:text-6xl font-black tracking-tight text-white leading-tight sm:leading-none break-words drop-shadow-xl">
                            {movie.title}
                        </h1>

                        <div class="flex flex-wrap items-center justify-center md:justify-start gap-2 sm:gap-3 text-xs font-bold uppercase tracking-wider text-neutral-400">
                            {movie.rating > 0 && (
                                <div class="flex items-center gap-1.5 text-yellow-400 bg-white/5 px-3 py-1.5 rounded-xl border border-white/10 backdrop-blur-md">
                                    <Star size={14} fill="currentColor" />
                                    <span class="text-white font-black">{movie.rating.toFixed(1)}</span>
                                </div>
                            )}
                            {movie.runtime > 0 && (
                                <div class="flex items-center gap-1.5 bg-white/5 px-3 py-1.5 rounded-xl border border-white/10 backdrop-blur-md">
                                    <Clock size={14} class="text-red-500" />
                                    <span class="text-white font-bold">{movie.runtime} MIN</span>
                                </div>
                            )}
                            {releaseYear && (
                                <div class="flex items-center gap-1.5 bg-white/5 px-3 py-1.5 rounded-xl border border-white/10 backdrop-blur-md">
                                    <Calendar size={14} class="text-red-500" />
                                    <span class="text-white font-bold">{releaseYear}</span>
                                </div>
                            )}
                        </div>

                        <p class="max-w-3xl text-xs sm:text-sm md:text-base font-medium leading-relaxed text-neutral-300 drop-shadow line-clamp-4 sm:line-clamp-none">
                            {movie.overview}
                        </p>
                    </div>
                </div>
            </div>
        </section>

        {/* CONTENT GRID */}
        <div class="relative z-20 max-w-7xl mx-auto space-y-12 sm:space-y-16 px-4 sm:px-6 lg:px-8 pb-20 sm:pb-32 min-w-0">
            <ServerNoteBanner client:load />
            
            <div class="w-full">
                <ClientStreamPlayer client:load 
                    tmdbId={movie.tmdbId}
                    imdbId={movie.imdbId}
                    title={movie.title}
                    posterPath={movie.posterPath}
                    backdropPath={movie.backdropPath}
                />
            </div>
            
            <div id="trailers-section" class="space-y-6 min-w-0">
                <KinocheckTrailerSection client:visible tmdbId={movie.tmdbId} title={movie.title} trailers={trailers} />
                <WatchmodeAvailabilityBanner client:visible tmdbId={movie.tmdbId} />
            </div>

            <div class="grid grid-cols-1 gap-10 lg:grid-cols-3 min-w-0">
                <div class="col-span-1 lg:col-span-2 min-w-0 overflow-hidden">
                    <CastRow client:visible cast={movie.cast} />
                </div>
            </div>

            <AdsterraNativeBanner client:load />
        </div>
    </main>
</Layout>
